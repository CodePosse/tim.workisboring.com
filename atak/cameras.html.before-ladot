<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>SoCal TAK/GIS Cameras | Public Camera Maps</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description"
    content="Camera dashboard for ATAK/GIS training, featuring ALERTCalifornia, Cal OES, USGS, Windy, and curated LIVE camera feeds.">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.ico">
  <link rel="canonical" href="https://tim.workisboring.com/atak/cameras.html">
  <meta property="og:type" content="website">
  <meta property="og:title" content="SoCal TAK/GIS Cameras">
  <meta property="og:description"
    content="Camera dashboard for ATAK/GIS training, featuring ALERTCalifornia, Cal OES, USGS, Windy, and curated LIVE camera feeds.">
  <meta property="og:logo" content="https://tim.workisboring.com/atak/img/social-card.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://tim.workisboring.com/atak/cameras.html">
  <meta property="og:site_name" content="tim.workisboring.com">
  <meta property="og:image" content="https://tim.workisboring.com/atak/img/social-card.png">
  <meta name="og:locale" content="en_US" />
  <meta name="og:region" content="US-CA" />
  <meta name="og:postal-code" content="90210" />
  <meta name="og:country-name" content="USA" />
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="SoCal TAK/GIS Cameras">
  <meta name="twitter:description"
    content="Camera dashboard for ATAK/GIS training, featuring ALERTCalifornia, Cal OES, USGS, Windy, and curated LIVE camera feeds.">
  <meta name="twitter:image" content="https://tim.workisboring.com/atak/img/social-card.png">
  
  <link href="/css/bootstrap.min.css"
        rel="stylesheet"
        >
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div id="app">
    <aside class="shadow-sm">
      <h1 class="h3 mb-2"><i class="bi bi-camera-video me-2" aria-hidden="true"></i>SoCal TAK/GIS Cameras</h1>
      <div class="subtitle text-body-secondary small mb-3">Public camera layers for <a href="https://tak.gov/" target="_blank"
          rel="noopener noreferrer">ATAK/CivTAK</a> training and situational awareness and anywhere KML files can be
        used in GIS applications like <a href="https://earth.google.com/web/?hl=en_US" target="_blank"
          rel="noopener noreferrer">Google Earth</a><br>
        <button type="button" id="share-link-btn" class="btn btn-outline-primary btn-sm mt-2"><i class="bi bi-share me-1" aria-hidden="true"></i>Share</button>
      </div>
      <div class="status alert alert-secondary py-2 px-3 mb-3" id="status" role="status">Select a camera layer to load.</div>



      <div class="filters mb-3">
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="alertwest" aria-label="ALERTCalifornia / AlertWest"> 🔥
          ALERTCalifornia / AlertWest</div>
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="caloes-fire" aria-label="Cal OES Fire"> 🔥 Cal OES Fire
        </div>
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="nifc-incidents" aria-label="NIFC Current Fire Incidents"> 🔥 NIFC Current Fires
        </div>
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="nifc-perimeters" aria-label="NIFC Current Fire Perimeters"> 🔴 NIFC Fire Perimeters
        </div>
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="caloes-traffic" aria-label="Cal OES Traffic"> 🚗 Cal OES
          Traffic</div>
        <div class="mygroup">
          <input class="form-check-input mt-0" type="checkbox" data-layer="caltrans" aria-label="Caltrans Traffic Cameras">
          🚗 Caltrans Traffic Cameras
        </div>

        <div class="mygroup">
          <input class="form-check-input mt-0" type="checkbox" data-layer="fox-weather" aria-label="FOX Weather Vision Cameras">
           🌎 Weather Vision Live Cameras
        </div>
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="usgs" aria-label="USGS River / Water"> 🌊 USGS River /
          Water</div>
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="windy" aria-label="windy"> 🌎 Windy Webcams</div>
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="curated-socal"
            aria-label="Curated Southern California cameras"> 🏖️ LIVE Beach, Mountain &amp; Attraction
        </div>
        <div class="mygroup"><input class="form-check-input mt-0" type="checkbox" data-layer="deflock" aria-label="deFLOCK CAMERAS"> 🚨 DeFlock ALPR
          Cameras in CA
        </div>
      </div>
      <input id="search" class="form-control mb-3 border-success" type="search" placeholder="Now search name, county, source…"
        aria-label="Now search cameras by name, county, or source">
      <details class="atak-help card card-body mb-3 bg-light" aria-labelledby="atak-help-title">
        <summary id="atak-help-title">Add a camera layer to ATAK +</summary>
        <ol>
          <li>Open ATAK-CIV on Android.</li>
          <li>Open the main menu and choose <strong>Import Manager</strong>.</li>
          <li>Choose <strong>Import from URL</strong>.</li>
          <li>Copy one Network KML URL below and paste it into ATAK.</li>
          <li>After import, pan/zoom to California and enable the overlay if needed.</li>
        </ol>
      </details>
      <details class="card card-body mb-3 bg-light">
        <summary>Network KML Files +</summary>
        <p class="links">
          <a href="/atak/data/kml/alertca-network.kml">ALERTCalifornia Network KML</a>
          <a href="/atak/data/kml/caloes-fire-network.kml">Cal OES Fire Network KML</a>
          <a href="/atak/data/kml/nifc-current-incidents-network.kml">NIFC Current Fire Incidents Network KML</a>
          <a href="/atak/data/kml/nifc-current-perimeters-network.kml">NIFC Current Fire Perimeters Network KML</a>
          <a href="/atak/data/kml/caloes-traffic-network.kml">Cal OES Traffic Network KML</a>
          <a href="/atak/data/kml/usgs-network.kml">USGS Network KML</a>
          <a href="/atak/data/kml/windy-webcams-network.kml">Windy Webcams Network KML</a>
          <a href="/atak/data/kml/curated-socal-network.kml">Curated LIVE Cameras KML</a>
          <a href="/atak/data/kml/deflock-socal-network.kml">ATAK: CA DeFlock ALPR Camera Map </a>
          <a href="/atak/caltrans-network.kml">ATAK: Caltrans Traffic Camera Network KML </a>
          <a href="/atak/fox-weather-network.kml">ATAK: FOX / Weather Vision Network KML </a>
          <a href="https://getgotak.com/blogs/news/making-the-invisible-visible-deflock-me-atak-map" target="_blank"
            rel="noopener">Flock Cameras (DIY)</a>
        </p>
      </details>

      <div class="camera-list" id="cameraList" aria-live="polite"></div>

      <div class="powered">
        <small>Powered by: <a href="https://github.com/CodePosse/tim.workisboring.com" rel="nofollow noopener"
            target="_blank">CodePosse</a> and
          <a href="https://maps.deflock.org/" rel="nofollow noopener" target="_blank"> Flock data provided by
            DeFlock </a></small>
      </div>
    </aside>

    <main id="map"></main>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/@mapbox/leaflet-omnivore@0.3.4/leaflet-omnivore.min.js"></script>
  <script>
    const SOURCES = {
      alertwest: {
        label: "ALERTCalifornia / AlertWest",
        json: "/atak/data/alertwest-cameras.json"
      },
      "caloes-fire": {
        label: "Cal OES Fire",
        json: "/atak/data/caloes-fire-cameras.json"
      },
      "nifc-incidents": {
        label: "NIFC Current Fires",
        json: "/atak/data/nifc/nifc-current-incidents.geojson",
        type: "geojson-incidents"
      },
      "nifc-perimeters": {
        label: "NIFC Fire Perimeters",
        json: "/atak/data/nifc/nifc-current-perimeters.geojson",
        type: "geojson-perimeters"
      },
      "caloes-traffic": {
        label: "Cal OES Traffic",
        json: "/atak/data/caloes-traffic-cameras.json"
      },
      caltrans: {
        label: "Caltrans Traffic Cameras",
        json: "/atak/data/caltrans-cameras.json"
      },
      "fox-weather": {
        label: "FOX / Weather Vision",
        json: "/atak/data/fox-weather-cameras.json"
      },
      deflock: {
        label: "DeFlock California ALPR Locations",
        json: "/atak/data/deflock-socal.json"
      },
      usgs: {
        label: "USGS River / Water",
        json: "/atak/data/usgs-cameras.json"
      },
      windy: {
        label: "Windy Tourist Webcams",
        json: "/atak/api/windy.php"
      },
      "curated-socal": {
        label: "Curated SoCal Beaches, Mountains & Attractions",
        json: "/atak/data/curated-socal-cameras.json"
      }
    };

    const FOX_WEATHER_FALLBACK_CAMERAS = [
      {
        id: "fox-weather-ontario-airport",
        name: "Ontario International Airport",
        source: "FOX 10 / Weather Vision",
        category: "Live Airport Webcam",
        lat: 34.0560,
        lon: -117.6012,
        city: "Ontario",
        county: "San Bernardino",
        url: "https://www.fox10phoenix.com/webcams-ontario",
        embedUrl: "https://www.fox10phoenix.com/webcams-ontario",
        streamType: "iframe",
        attribution: "FOX 10 Phoenix / Weather Vision",
        featured: true,
        priority: 85,
        tags: ["Ontario", "airport", "San Bernardino County", "live webcam"]
      },
      {
        id: "fox-weather-oakland-estuary",
        name: "Oakland Estuary – San Francisco Bay",
        source: "FOX 10 / Weather Vision",
        category: "Live Bay Webcam",
        lat: 37.7955,
        lon: -122.2780,
        city: "Oakland",
        county: "Alameda",
        url: "https://www.fox10phoenix.com/webcams-sf-bay",
        embedUrl: "https://www.fox10phoenix.com/webcams-sf-bay",
        streamType: "iframe",
        attribution: "FOX 10 Phoenix / Weather Vision",
        featured: true,
        priority: 75,
        tags: ["Oakland", "San Francisco Bay", "estuary", "live webcam"]
      },
      {
        id: "fox-weather-bay-point",
        name: "Bay Point – Highway 4",
        source: "FOX 10 / Weather Vision",
        category: "Live Traffic Webcam",
        lat: 38.0291,
        lon: -121.9616,
        city: "Bay Point",
        county: "Contra Costa",
        url: "https://www.fox10phoenix.com/webcams-bay-point",
        embedUrl: "https://www.fox10phoenix.com/webcams-bay-point",
        streamType: "iframe",
        attribution: "FOX 10 Phoenix / Weather Vision",
        featured: true,
        priority: 75,
        tags: ["Bay Point", "Highway 4", "traffic", "live webcam"]
      },
      {
        id: "fox-weather-emeryville",
        name: "Emeryville – Oakland Area",
        source: "FOX 10 / Weather Vision",
        category: "Live City Webcam",
        lat: 37.8313,
        lon: -122.2852,
        city: "Emeryville",
        county: "Alameda",
        url: "https://www.fox10phoenix.com/webcams-emeryville",
        embedUrl: "https://www.fox10phoenix.com/webcams-emeryville",
        streamType: "iframe",
        attribution: "FOX 10 Phoenix / Weather Vision",
        featured: true,
        priority: 75,
        tags: ["Emeryville", "Oakland", "San Francisco Bay", "live webcam"]
      },
      {
        id: "fox-weather-santa-monica",
        name: "Santa Monica Beach",
        source: "FOX 10 / Weather Vision",
        category: "Live Beach Webcam",
        lat: 34.0094,
        lon: -118.4973,
        city: "Santa Monica",
        county: "Los Angeles",
        url: "https://www.fox10phoenix.com/webcams-santa-monica-beach",
        embedUrl: "https://api.wetmet.net/widgets/stream/frame.php?uid=0985333ee65625a3b1139ed97b4f27bc",
        streamType: "iframe",
        attribution: "FOX 10 Phoenix / Weather Vision",
        featured: true,
        priority: 90,
        tags: ["Santa Monica", "beach", "ocean", "live webcam"]
      }
    ];

    function mergeUniqueCameras(primary, fallback) {
      const records = new Map();

      const cameraKey = camera =>
        camera.id ||
        camera.url ||
        `${camera.name || ""}|${camera.lat ?? camera.latitude}|${camera.lon ?? camera.longitude}`;

      fallback.forEach(camera => {
        const key = cameraKey(camera);
        if (key) records.set(key, { ...camera });
      });

      primary.forEach(camera => {
        const key = cameraKey(camera);
        if (!key) return;

        const existing = records.get(key) || {};
        const merged = { ...existing, ...camera };

        merged.embedUrl =
          camera.embedUrl ||
          camera.embed_url ||
          existing.embedUrl ||
          existing.embed_url ||
          "";

        merged.embed_url = merged.embedUrl;
        merged.streamType =
          camera.streamType ||
          camera.stream_type ||
          existing.streamType ||
          existing.stream_type ||
          (merged.embedUrl ? "iframe" : "external-page");

        records.set(key, merged);
      });

      return [...records.values()];
    }

    const map = L.map("map").setView([34.35, -117.8], 7);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution: "&copy; OpenStreetMap contributors"
    }).addTo(map);

    const layers = {};
    Object.keys(SOURCES).forEach(key => {
      layers[key] = L.layerGroup();
    });

    const loadedLayers = new Set();
    let allCameras = [];

    const fireFeatureCounts = {
      "nifc-incidents": 0,
      "nifc-perimeters": 0
    };

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function getYouTubeVideoId(value) {
      if (!value) return "";

      try {
        const url = new URL(value, window.location.origin);
        const host = url.hostname.replace(/^www\./, "");

        if (host === "youtu.be") {
          return url.pathname.split("/").filter(Boolean)[0] || "";
        }

        if (host === "youtube.com" || host === "m.youtube.com" || host === "music.youtube.com") {
          if (url.pathname === "/watch") {
            return url.searchParams.get("v") || "";
          }

          const parts = url.pathname.split("/").filter(Boolean);
          if (["embed", "live", "shorts"].includes(parts[0])) {
            return parts[1] || "";
          }
        }
      } catch (error) {
        console.warn("Invalid YouTube URL:", value, error);
      }

      return "";
    }

    function cameraPopup(cam) {
      const youtubeUrl = cam.youtubeUrl || "";
      const channelUrl = cam.channelUrl || "";
      const embedUrl = cam.embedUrl || cam.embed_url || "";
      const youtubeId = getYouTubeVideoId(youtubeUrl);
      const largeImageUrl =
        cam.originalImageUrl ||
        cam.fullImageUrl ||
        cam.largeImageUrl ||
        cam.imageUrl ||
        cam.thumbnail ||
        "";

      const mediaControls = [];

      if (youtubeId) {
        mediaControls.push(`
          <button type="button" class="video-toggle btn btn-primary btn-sm" data-youtube-id="${escapeHtml(youtubeId)}">
            Show video
          </button>
        `);
      }

      if (embedUrl) {
        mediaControls.push(`
          <button type="button"
                  class="live-player-toggle btn btn-live btn-sm"
                  data-embed-url="${escapeHtml(embedUrl)}">
            <i class="bi bi-play-circle-fill me-1" aria-hidden="true"></i>Play live camera
          </button>
        `);
      }

      const thumbnailUrl =
        cam.thumbnail ||
        cam.imageUrl ||
        largeImageUrl ||
        "";

      if (youtubeId || embedUrl || largeImageUrl) {
        mediaControls.push(`
          <button type="button" class="popup-expand-toggle btn btn-outline-secondary btn-sm">
            Expand
          </button>
        `);
      }

      const imageSection = !youtubeId && thumbnailUrl ? `
        <div class="popup-image">
          <button type="button"
                  class="image-expand-toggle"
                  data-thumbnail-url="${escapeHtml(thumbnailUrl)}"
                  data-large-image-url="${escapeHtml(largeImageUrl || thumbnailUrl)}"
                  aria-label="Expand ${escapeHtml(cam.name)} image">
            <img src="${escapeHtml(thumbnailUrl)}"
                 alt="${escapeHtml(cam.name)} current view"
                 loading="lazy"
                 decoding="async">
          </button>
        </div>
      ` : "";

      const mediaSection = mediaControls.length || imageSection ? `
        ${mediaControls.length ? `<div class="popup-actions">${mediaControls.join("")}</div>` : ""}
        ${youtubeId ? '<div class="popup-video" aria-hidden="true"></div>' : ""}
        ${embedUrl ? '<div class="popup-live-player" aria-hidden="true" hidden></div>' : ""}
        ${imageSection}
      ` : "";

      return `
        <div class="popup">
          <span class="badge text-bg-secondary">${escapeHtml(cam.category || cam.source)}</span><br>
          <strong>${escapeHtml(cam.name)}</strong><br>
          Source: ${escapeHtml(cam.source || "")}<br>
          ${cam.operator && cam.operator !== cam.source ? `Operator: ${escapeHtml(cam.operator)}<br>` : ""}
          ${cam.city ? `City: ${escapeHtml(cam.city)}<br>` : ""}
          ${cam.county ? `County: ${escapeHtml(cam.county)}<br>` : ""}
          ${cam.description ? `${escapeHtml(cam.description)}<br>` : ""}
          ${cam.heading ? `View: ${escapeHtml(cam.heading)}°<br>` : ""}
          ${embedUrl ? `<div class="live-available"><i class="bi bi-broadcast-pin me-1" aria-hidden="true"></i>Embedded live player available</div>` : ""}
          ${cam.url ? `<a class="btn btn-outline-primary btn-sm my-1" href="${escapeHtml(cam.url)}" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-1"></i>Open camera page</a><br>` : ""}
          ${channelUrl ? `<a href="${escapeHtml(channelUrl)}" target="_blank" rel="noopener">Open YouTube streams</a><br>` : ""}
          ${cam.tags?.length ? `Tags: ${escapeHtml(cam.tags.join(", "))}<br>` : ""}
          ${cam.timelapse ? `<a href="${escapeHtml(cam.timelapse)}" target="_blank" rel="noopener">Open timelapse</a><br>` : ""}
          ${mediaSection}
          ${cam.attribution ? `<small>${escapeHtml(cam.attribution)}</small>` : ""}
        </div>
      `;
    }

    function addCamera(cam) {
      const lat = Number(cam.lat ?? cam.latitude);
      const lon = Number(cam.lon ?? cam.longitude);

      if (!Number.isFinite(lat) || !Number.isFinite(lon) || !layers[cam.layer]) return;

      const normalizedCamera = {
        ...cam,
        lat,
        lon,
        source: cam.source || cam.operator || SOURCES[cam.layer]?.label || "",
        url: cam.url || cam.pageUrl || cam.streamUrl || "",
        thumbnail: cam.thumbnail || cam.imageUrl || "",
        imageUrl: cam.imageUrl || "",
        largeImageUrl: cam.largeImageUrl || cam.previewUrl || "",
        fullImageUrl: cam.fullImageUrl || "",
        originalImageUrl: cam.originalImageUrl || "",
        youtubeUrl: cam.youtubeUrl || cam.youtube || "",
        channelUrl: cam.channelUrl || "",
        embedUrl: cam.embedUrl || cam.embed_url || "",
        sourceType: cam.sourceType || "webcam",
        priority: Number(cam.priority ?? 50),
        featured: Boolean(cam.featured),
        tags: Array.isArray(cam.tags) ? cam.tags : [],
        category: cam.category || "Camera"
      };

      const marker = L.marker([lat, lon]).bindPopup(cameraPopup(normalizedCamera), {
        maxWidth: 920,
        minWidth: 300,
        autoPanPadding: [24, 24]
      });
      marker.addTo(layers[cam.layer]);
      normalizedCamera.marker = marker;
      allCameras.push(normalizedCamera);
    }

    function firstNifcValue(properties, keys, fallback = "") {
      for (const key of keys) {
        const value = properties?.[key];
        if (value !== undefined && value !== null && value !== "") return value;
      }
      return fallback;
    }

    function formatNifcNumber(value) {
      if (value === undefined || value === null || value === "") return "";
      const number = Number(value);
      return Number.isFinite(number)
        ? number.toLocaleString(undefined, { maximumFractionDigits: 1 })
        : String(value);
    }

    function formatNifcDate(value) {
      if (value === undefined || value === null || value === "") return "";
      let date;
      if (typeof value === "number") {
        date = new Date(value);
      } else {
        const numeric = Number(value);
        date = Number.isFinite(numeric) && String(value).length >= 10
          ? new Date(numeric)
          : new Date(value);
      }
      return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleString();
    }

    function nifcPopupRow(label, value) {
      if (value === undefined || value === null || value === "") return "";
      return `<tr><td><strong>${escapeHtml(label)}</strong></td><td>${escapeHtml(value)}</td></tr>`;
    }

    function nifcIncidentPopup(feature) {
      const p = feature.properties || {};
      const name = firstNifcValue(p, ["IncidentName", "IncidentNameClean"], "Unnamed Fire");
      const acres = firstNifcValue(p, ["DailyAcres", "CalculatedAcres", "DiscoveryAcres", "GISAcres"]);
      const contained = firstNifcValue(p, ["PercentContained"]);
      const cause = firstNifcValue(p, ["FireCause", "FireCauseGeneral"]);
      const discovery = firstNifcValue(p, ["FireDiscoveryDateTime", "DiscoveryDate"]);
      const type = firstNifcValue(p, ["IncidentTypeCategory", "IncidentTypeKind", "IncidentType"]);
      const agency = firstNifcValue(p, ["POOProtectingAgency", "PrimaryFireOrganization", "UnitOrOtherAgencyIdentifier"]);
      const irwin = firstNifcValue(p, ["IrwinID", "IRWINID"]);

      return `
        <div class="popup">
          <span class="badge text-bg-danger">Current Fire</span><br>
          <strong>🔥 ${escapeHtml(name)}</strong>
          <table class="table table-sm mt-2 mb-1">
            ${type ? nifcPopupRow("Type", type) : ""}
            ${acres !== "" ? nifcPopupRow("Acres", formatNifcNumber(acres)) : ""}
            ${contained !== "" ? nifcPopupRow("Contained", `${formatNifcNumber(contained)}%`) : ""}
            ${cause ? nifcPopupRow("Cause", cause) : ""}
            ${discovery ? nifcPopupRow("Discovery", formatNifcDate(discovery)) : ""}
            ${agency ? nifcPopupRow("Agency", agency) : ""}
            ${irwin ? nifcPopupRow("IRWIN ID", irwin) : ""}
          </table>
          <small>Source: NIFC / WFIGS</small>
        </div>
      `;
    }

    function nifcPerimeterPopup(feature) {
      const p = feature.properties || {};
      const name = firstNifcValue(p, ["IncidentName", "IncidentNameClean"], "Unnamed Fire");
      const acres = firstNifcValue(p, ["GISAcres", "CalculatedAcres", "DailyAcres"]);
      const date = firstNifcValue(p, ["DateCurrent", "CurrentDate", "CreateDate", "ModifiedOnDateTime_dt"]);
      const type = firstNifcValue(p, ["IncidentTypeCategory", "IncidentTypeKind", "IncidentType"]);

      return `
        <div class="popup">
          <span class="badge text-bg-warning">Fire Perimeter</span><br>
          <strong>🔥 ${escapeHtml(name)}</strong>
          <table class="table table-sm mt-2 mb-1">
            ${type ? nifcPopupRow("Type", type) : ""}
            ${acres !== "" ? nifcPopupRow("Acres", formatNifcNumber(acres)) : ""}
            ${date ? nifcPopupRow("Perimeter Date", formatNifcDate(date)) : ""}
          </table>
          <small>Source: NIFC / WFIGS</small>
        </div>
      `;
    }

    function nifcIsPrescribedFire(feature) {
      const p = feature.properties || {};
      const values = [
        p.FeatureCategory,
        p.IncidentTypeCategory,
        p.IncidentTypeKind,
        p.IncidentType
      ].filter(Boolean).join(" ").toLowerCase();

      return values.includes("prescribed") || values.split(/\s+/).includes("rx");
    }

    function nifcPerimeterStyle(feature) {
      if (nifcIsPrescribedFire(feature)) {
        return {
          color: "#fd7e14",
          weight: 2,
          opacity: 0.9,
          fillColor: "#fd7e14",
          fillOpacity: 0.20
        };
      }

      return {
        color: "#dc3545",
        weight: 2,
        opacity: 0.95,
        fillColor: "#dc3545",
        fillOpacity: 0.20
      };
    }

    const nifcIncidentIcon = L.divIcon({
      className: "",
      html: '<div style="display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;border:2px solid #fff;background:#dc3545;color:#fff;box-shadow:0 1px 4px rgba(0,0,0,.45);font-size:16px;line-height:1;">🔥</div>',
      iconSize: [28, 28],
      iconAnchor: [14, 14],
      popupAnchor: [0, -14]
    });

    function addNifcIncidentFeature(feature, layerName) {
      if (feature?.geometry?.type !== "Point") return;
      const coords = feature.geometry.coordinates;
      if (!Array.isArray(coords) || coords.length < 2) return;

      const lon = Number(coords[0]);
      const lat = Number(coords[1]);
      if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;

      const p = feature.properties || {};
      const name = firstNifcValue(p, ["IncidentName", "IncidentNameClean"], "Unnamed Fire");
      const acres = firstNifcValue(p, ["DailyAcres", "CalculatedAcres", "DiscoveryAcres", "GISAcres"]);
      const county = firstNifcValue(p, ["POOCounty", "County"]);
      const marker = L.marker([lat, lon], { icon: nifcIncidentIcon })
        .bindPopup(nifcIncidentPopup(feature), {
          maxWidth: 920,
          minWidth: 300,
          autoPanPadding: [24, 24]
        });

      marker.addTo(layers[layerName]);

      allCameras.push({
        id: firstNifcValue(p, ["IrwinID", "IRWINID", "UniqueFireIdentifier"], `nifc-${lat}-${lon}`),
        name,
        source: "NIFC / WFIGS",
        operator: firstNifcValue(p, ["POOProtectingAgency", "PrimaryFireOrganization"]),
        category: "Current Fire",
        city: "",
        county,
        sourceType: "wildfire",
        priority: 100,
        featured: true,
        tags: ["NIFC", "WFIGS", "wildfire", acres !== "" ? `${formatNifcNumber(acres)} acres` : ""].filter(Boolean),
        lat,
        lon,
        layer: layerName,
        marker
      });
    }

    function addNifcPerimeterFeatures(payload, layerName) {
      const geoJsonLayer = L.geoJSON(payload, {
        style: nifcPerimeterStyle,
        onEachFeature(feature, layer) {
          layer.bindPopup(nifcPerimeterPopup(feature), {
            maxWidth: 920,
            minWidth: 300,
            autoPanPadding: [24, 24]
          });
        }
      });

      geoJsonLayer.addTo(layers[layerName]);
    }

    async function ensureLayerLoaded(layerName) {
      if (loadedLayers.has(layerName)) return;

      const source = SOURCES[layerName];
      document.getElementById("status").textContent = `Loading ${source.label}…`;

      const shouldBypassCache =
        layerName === "windy" ||
        layerName === "curated-socal" ||
        source.type === "geojson-incidents" ||
        source.type === "geojson-perimeters";

      const requestUrl = shouldBypassCache
        ? `${source.json}${source.json.includes("?") ? "&" : "?"}t=${Date.now()}`
        : source.json;

      const response = await fetch(requestUrl, {
        cache: shouldBypassCache ? "no-store" : "default"
      });

      if (!response.ok) throw new Error(`Failed to load ${source.label}`);

      const payload = await response.json();

      if (source.type === "geojson-incidents") {
        if (payload?.type !== "FeatureCollection" || !Array.isArray(payload.features)) {
          throw new Error(`Invalid GeoJSON returned for ${source.label}`);
        }

        fireFeatureCounts["nifc-incidents"] = payload.features.length;

        payload.features.forEach(feature => addNifcIncidentFeature(feature, layerName));
        loadedLayers.add(layerName);
        return;
      }

      if (source.type === "geojson-perimeters") {
        if (payload?.type !== "FeatureCollection" || !Array.isArray(payload.features)) {
          throw new Error(`Invalid GeoJSON returned for ${source.label}`);
        }

        fireFeatureCounts["nifc-perimeters"] = payload.features.length;

        addNifcPerimeterFeatures(payload, layerName);
        loadedLayers.add(layerName);
        return;
      }

      const cameras = layerName === "fox-weather"
        ? mergeUniqueCameras(payload.cameras || [], FOX_WEATHER_FALLBACK_CAMERAS)
        : (payload.cameras || []);

      cameras.forEach(cam => {
        addCamera({ ...cam, layer: layerName });
      });

      loadedLayers.add(layerName);
    }

    function renderList() {
      const query = document.getElementById("search").value.toLowerCase().trim();
      const active = new Set(
        [...document.querySelectorAll("[data-layer]:checked")].map(input => input.dataset.layer)
      );

      const filtered = allCameras.filter(cam => {
        if (!active.has(cam.layer)) return false;
        if (!query) return true;

        return [
          cam.name,
          cam.source,
          cam.operator,
          cam.category,
          cam.city,
          cam.county,
          cam.sourceType,
          ...(cam.tags || [])
        ].join(" ").toLowerCase().includes(query);
      });

      filtered.sort((a, b) =>
        Number(b.featured) - Number(a.featured) ||
        Number(b.priority || 0) - Number(a.priority || 0) ||
        String(a.name || "").localeCompare(String(b.name || ""))
      );

      const list = document.getElementById("cameraList");
      list.innerHTML = "";

      filtered.slice(0, 100).forEach(cam => {
        const card = document.createElement("div");
        card.className = "card border-1 text-dark";
        card.innerHTML = `
          <span class="badge text-primary mb-1">${cam.featured ? "★ " : ""}${escapeHtml(cam.category || cam.layer)}</span>
          <strong>${escapeHtml(cam.name)}</strong>
          <div class="fs-6 fw-light">${escapeHtml(cam.source || "")}${cam.city ? " · " + escapeHtml(cam.city) : ""}${cam.county ? " · " + escapeHtml(cam.county) : ""}</div>
        `;
        card.addEventListener("click", () => {
          map.setView([cam.lat, cam.lon], 12);
          cam.marker.openPopup();
        });
        list.appendChild(card);
      });

      const nifcIncidentsActive =
        document.querySelector('[data-layer="nifc-incidents"]')?.checked;

      const nifcPerimetersActive =
        document.querySelector('[data-layer="nifc-perimeters"]')?.checked;

      const visibleCameraCount = filtered.filter(
        item => item.layer !== "nifc-incidents"
      ).length;

      const parts = [
        `${visibleCameraCount} visible cameras`
      ];

      if (nifcIncidentsActive) {
        parts.push(`${fireFeatureCounts["nifc-incidents"]} NIFC fires`);
      }

      if (nifcPerimetersActive) {
        parts.push(`${fireFeatureCounts["nifc-perimeters"]} fire perimeters`);
      }

      document.getElementById("status").textContent = parts.join(" · ");
    }

    document.querySelectorAll("[data-layer]").forEach(input => {
      input.addEventListener("change", async () => {
        const layerName = input.dataset.layer;
        const layer = layers[layerName];

        try {
          if (input.checked) {
            await ensureLayerLoaded(layerName);
            map.addLayer(layer);
          } else {
            map.removeLayer(layer);
          }

          renderList();
        } catch (error) {
          console.error(error);
          input.checked = false;
          document.getElementById("status").textContent = `Failed to load ${SOURCES[layerName].label}.`;
        }
      });
    });

    document.getElementById("search").addEventListener("input", renderList);

    document.addEventListener("click", event => {
      const videoButton = event.target.closest(".video-toggle");

      if (videoButton) {
        const popup = videoButton.closest(".popup");
        const videoContainer = popup?.querySelector(".popup-video");
        const videoId = videoButton.dataset.youtubeId;

        if (!popup || !videoContainer || !videoId) return;

        const isVisible = videoContainer.classList.toggle("is-visible");
        videoContainer.setAttribute("aria-hidden", String(!isVisible));
        videoButton.textContent = isVisible ? "Hide video" : "Show video";

        if (isVisible && !videoContainer.querySelector("iframe")) {
          const iframe = document.createElement("iframe");
          iframe.src =
            `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0`;
          iframe.title = `${popup.querySelector("strong")?.textContent || "Camera"} live video`;
          iframe.loading = "lazy";
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.referrerPolicy = "strict-origin-when-cross-origin";
          iframe.allowFullscreen = true;
          videoContainer.appendChild(iframe);
        }

        map.invalidateSize();
        return;
      }

      const livePlayerButton = event.target.closest(".live-player-toggle");

      if (livePlayerButton) {
        const popup = livePlayerButton.closest(".popup");
        const livePlayer = popup?.querySelector(".popup-live-player");
        const embedUrl = livePlayerButton.dataset.embedUrl;

        if (!popup || !livePlayer || !embedUrl) return;

        const isVisible = livePlayer.hidden;
        livePlayer.hidden = !isVisible;
        livePlayer.setAttribute("aria-hidden", String(!isVisible));
        livePlayerButton.innerHTML = isVisible
          ? '<i class="bi bi-stop-circle me-1" aria-hidden="true"></i>Stop live camera'
          : '<i class="bi bi-play-circle-fill me-1" aria-hidden="true"></i>Play live camera';

        if (isVisible && !livePlayer.querySelector("iframe")) {
          const frameWrapper = document.createElement("div");
          frameWrapper.className = "popup-live-player-frame";

          const iframe = document.createElement("iframe");
          iframe.src = embedUrl;
          iframe.title = `${popup.querySelector("strong")?.textContent || "Camera"} FOX Weather Vision live player`;
          iframe.loading = "lazy";
          iframe.allow = "autoplay; fullscreen; picture-in-picture";
          iframe.sandbox = "allow-scripts allow-same-origin allow-forms allow-popups allow-presentation";
          iframe.referrerPolicy = "strict-origin-when-cross-origin";
          iframe.allowFullscreen = true;

          frameWrapper.appendChild(iframe);
          livePlayer.appendChild(frameWrapper);
        } else if (!isVisible) {
          livePlayer.replaceChildren();
        }

        const leafletContent = livePlayerButton.closest(".leaflet-popup-content");
        if (leafletContent && isVisible) {
          leafletContent.style.width = "min(80vw, 900px)";
          popup.classList.add("expanded");

          const expandButton = popup.querySelector(".popup-expand-toggle");
          if (expandButton) expandButton.textContent = "Collapse";
        }

        map.invalidateSize();
        return;
      }

      const imageButton = event.target.closest(".image-expand-toggle");

      if (imageButton) {
        const popup = imageButton.closest(".popup");
        const leafletContent = imageButton.closest(".leaflet-popup-content");
        const image = imageButton.querySelector("img");
        const thumbnailUrl = imageButton.dataset.thumbnailUrl;
        const largeImageUrl = imageButton.dataset.largeImageUrl || thumbnailUrl;

        if (!popup || !leafletContent || !image || !largeImageUrl) return;

        const expanded = popup.classList.toggle("expanded");
        leafletContent.style.width = expanded ? "min(80vw, 900px)" : "340px";
        image.src = expanded ? largeImageUrl : thumbnailUrl;
        imageButton.setAttribute(
          "aria-label",
          expanded ? "Collapse camera image" : "Expand camera image"
        );

        const expandButton = popup.querySelector(".popup-expand-toggle");
        if (expandButton) {
          expandButton.textContent = expanded ? "Collapse" : "Expand";
        }

        map.invalidateSize();
        return;
      }

      const expandButton = event.target.closest(".popup-expand-toggle");

      if (expandButton) {
        const popup = expandButton.closest(".popup");
        const leafletContent = expandButton.closest(".leaflet-popup-content");

        if (!popup || !leafletContent) return;

        const expanded = popup.classList.toggle("expanded");
        expandButton.textContent = expanded ? "Collapse" : "Expand";
        leafletContent.style.width = expanded ? "min(80vw, 900px)" : "340px";

        const imageButton = popup.querySelector(".image-expand-toggle");
        const image = imageButton?.querySelector("img");

        if (imageButton && image) {
          const thumbnailUrl = imageButton.dataset.thumbnailUrl;
          const largeImageUrl = imageButton.dataset.largeImageUrl || thumbnailUrl;
          image.src = expanded ? largeImageUrl : thumbnailUrl;
          imageButton.setAttribute(
            "aria-label",
            expanded ? "Collapse camera image" : "Expand camera image"
          );
        }

        map.invalidateSize();
      }
    });

    map.on("popupclose", event => {
      const popupElement = event.popup?.getElement();
      if (!popupElement) return;

      popupElement.querySelectorAll(".popup-live-player").forEach(player => {
        player.replaceChildren();
        player.hidden = true;
        player.setAttribute("aria-hidden", "true");
      });
    });

    const shareLinkBtn = document.getElementById("share-link-btn");

    if (shareLinkBtn) {
      shareLinkBtn.addEventListener("click", async () => {
        const shareData = {
          title: document.title,
          text: "SoCal TAK/GIS Cameras",
          url: document.location.href
        };

        try {
          if (navigator.share) {
            await navigator.share(shareData);
          } else {
            await navigator.clipboard.writeText(document.location.href);
            document.getElementById("status").textContent = "Link copied to clipboard.";
          }
        } catch (error) {
          console.error("Error sharing content:", error);
        }
      });
    }
    console.log("%c Welcome to: " + window.location.href + " now go home or my GitHub: CodePosse", "background: navy; color: #bada55; font-size: 28px;font-family:'Comic Sans MS';padding:10px;border:3px dashed red;");

  </script>

  <script src="/js/bootstrap.bundle.min.js"></script>
</body>

</html>